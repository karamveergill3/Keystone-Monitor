# Copy to .env.local for local development. On Vercel, set the same names
# under Project Settings -> Environment Variables. docs/NEW-MACHINE.md walks
# through it.
#
# THERE IS ONE DATABASE. A local copy of the site reads and writes the same
# Supabase project as the live one.

# Supabase project avsfygkauoipytiqraau. Not a secret, but only the server
# uses it: the browser never talks to Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://avsfygkauoipytiqraau.supabase.co

# Bypasses row-level security, and is how the site reads everything it
# shows. Server-only: never prefix with NEXT_PUBLIC_, never import
# src/lib/db.js or src/lib/supabase/admin.js from a "use client" file. The
# project's SECRET key (sb_secret_...): Supabase dashboard, Project Settings
# -> API Keys -> "Publishable and secret API keys" -> Secret keys. (The
# legacy service_role key also works until Supabase retires it at the end of
# 2026.) `vercel env pull` cannot fetch it: Vercel returns [SENSITIVE] for
# variables stored as Sensitive.
SUPABASE_SERVICE_ROLE_KEY=

# The site's public address, no trailing slash. The SyncUrl on the admin
# screen is built from this, and it is the origin each MT5 terminal must
# allow under Tools -> Options -> Expert Advisors -> Allow WebRequest.
# Locally, use http://localhost:3000.
APP_URL=https://keystone-monitor.vercel.app

# The one password for /admin, at least 12 characters. Without it the admin
# screen is switched off. Changing it signs every browser out of admin.
# Mark it Sensitive in Vercel.
ADMIN_PASSWORD=

# Optional. How often the EA syncs when nothing is happening, in seconds
# (30 to 600, default 120). Closing trades always sync straight away.
# SYNC_INTERVAL_SEC=120

# Optional. The name shown in the header, the tab and on the PDFs.
# NEXT_PUBLIC_APP_NAME=Keystone Monitor
