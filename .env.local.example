# Copy to .env.local for local development. On Vercel, set the same names
# under Project Settings -> Environment Variables.

# Supabase: Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Bypasses row-level security. Server-only: never prefix with NEXT_PUBLIC_,
# never import src/lib/supabase/admin.js from a "use client" file.
SUPABASE_SERVICE_ROLE_KEY=

# The site's public address, no trailing slash. Invite and password links
# are built from this, and it is the origin each MT5 terminal must allow
# under Tools -> Options -> Expert Advisors -> Allow WebRequest.
APP_URL=https://partners.example.com

# Optional. How often the EA syncs when nothing is happening, in seconds
# (30 to 600, default 120). Closing trades always sync straight away.
# SYNC_INTERVAL_SEC=120

# Optional. The name shown in the header, the tab and on the PDFs.
# NEXT_PUBLIC_APP_NAME=Partner Tracker
