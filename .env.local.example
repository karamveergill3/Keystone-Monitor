# Copy to .env.local for local development. On Vercel, set the same names
# under Project Settings -> Environment Variables. docs/NEW-MACHINE.md walks
# through it.
#
# THERE IS ONE DATABASE. A local copy of the site reads and writes the same
# Supabase project as the live one.

# Supabase project avsfygkauoipytiqraau. Both values are public by design:
# they are sent to every visitor's browser, and row-level security is what
# protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://avsfygkauoipytiqraau.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImF2c2Z5Z2thdW9pcHl0aXFyYWF1Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTIyNDEzNTEsImV4cCI6MjEwNzgxNzM1MX0.y8WHwD9SeMmLGKzLB4IcU4Jrb2OS1-oqeZfmxhxo_8U

# Bypasses row-level security. Server-only: never prefix with NEXT_PUBLIC_,
# never import src/lib/supabase/admin.js from a "use client" file. From the
# Supabase dashboard: Project Settings -> API Keys -> Legacy API keys ->
# service_role. `vercel env pull` cannot fetch it: Vercel returns
# [SENSITIVE] for variables stored as Sensitive.
SUPABASE_SERVICE_ROLE_KEY=

# The site's public address, no trailing slash. Invite and password links
# are built from this, and it is the origin each MT5 terminal must allow
# under Tools -> Options -> Expert Advisors -> Allow WebRequest.
# Locally, use http://localhost:3000.
APP_URL=https://keystone-monitor.vercel.app

# Optional. How often the EA syncs when nothing is happening, in seconds
# (30 to 600, default 120). Closing trades always sync straight away.
# SYNC_INTERVAL_SEC=120

# Optional. The name shown in the header, the tab and on the PDFs.
# NEXT_PUBLIC_APP_NAME=Keystone Monitor
