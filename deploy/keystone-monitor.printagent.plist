<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Keystone Monitor print agent, as a LaunchAgent for the user signed in on
  the office Mac. docs/print-agent.md says how to install it.

  Before installing, replace:
    /ABSOLUTE/PATH/TO/node   with the output of `command -v node` (Node 22+)
    /ABSOLUTE/PATH/TO/Keystone-Monitor   with where the repository is cloned
    /Users/USERNAME          with the Mac user's home folder

  The agent's settings (the key among them) live in
  ~/.keystone-monitor-print.env, mode 600, never in this file.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>keystone-monitor.printagent</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>[ -r "$HOME/.keystone-monitor-print.env" ] &amp;&amp; { set -a; . "$HOME/.keystone-monitor-print.env"; set +a; }; exec /ABSOLUTE/PATH/TO/node /ABSOLUTE/PATH/TO/Keystone-Monitor/scripts/print-agent.mjs</string>
  </array>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>/Users/USERNAME/Library/Logs/keystone-monitor-print-agent.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/USERNAME/Library/Logs/keystone-monitor-print-agent.log</string>
</dict>
</plist>
